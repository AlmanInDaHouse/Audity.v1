# Runtime
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://audity:audity@postgres:5432/audity
REDIS_URL=redis://redis:6379/0
TEMPORAL_SERVER=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=audit-run-queue
WORKFLOW_MODE=temporal

# Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=audity-evidence
MINIO_SECURE=false
STORAGE_BACKEND=s3

# Catalogs
CATALOG_DIR=/workspace/catalogs

# Auth / OIDC mock
OIDC_ISSUER=https://localhost:5443/api
OIDC_KEY_ID=audity-dev-key
OIDC_PRIVATE_KEY_B64=
OIDC_PRIVATE_KEY_PATH=/workspace/.data/oidc_signing_key.pem
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_TOKEN_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
MFA_REQUIRED_SENSITIVE=false
DEMO_ORG_ID=

# Connectors (optional)
GITHUB_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# LLM / Assistant
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_MANUAL_EVIDENCE=4

# API
API_BASE_URL=https://localhost:5443/api
RATE_LIMIT_PER_MINUTE=120
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:53000,http://127.0.0.1:53000,https://localhost:5443,https://127.0.0.1:5443
SENSITIVE_RATE_LIMIT_PER_MINUTE=20

# Enterprise feature flags
ENTERPRISE_FEATURES_ENABLED=false
FEATURE_AUTH_ENTERPRISE=false
FEATURE_SCIM=false
FEATURE_SECRET_STORE=false
FEATURE_UPLOAD_AV_SCAN=false
FEATURE_SIGNING=false
FEATURE_TSA=false
FEATURE_RBAC_ABAC=false
FEATURE_APPROVALS=false
FEATURE_REPORTING_PACKAGE=false
FEATURE_PRICING=false

# Secret store and encryption
SECRET_STORE_BACKEND=db
# Required outside dev/local/demo_controlado. Generate 32+ random bytes and keep it persistent.
SECRET_ENCRYPTION_KEY=
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_MOUNT_KV=secret
VAULT_MOUNT_TRANSIT=transit

# Upload and AV
UPLOAD_DEFAULT_MAX_MB=20
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# Timestamping
TSA_PROVIDER=stub
TSA_URL=

# Telemetry
TELEMETRY_ENABLED=false
METRICS_ENABLED=true
OTLP_ENDPOINT=http://otel-collector:4317
